{
  "name": "stext-next",
  "private": true,
  "type": "module",
  "description": "SORCERIAN Text v2 (gamebook engine) monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @stext/player",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/player/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w @stext/player",
    "clean": "tsc -b --clean && rm -rf apps/*/dist",
    "schema": "node scripts/write-json-schema.mjs",
    "convert:legacy": "node packages/cli/dist/bin.js convert-all ../stext/stext -o scenarios",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
